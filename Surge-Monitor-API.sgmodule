#!name=Surge Monitor API
#!desc=显示本机 Surge 运行时间、内存与接口累计流量。安装时请填写 Surge HTTP API Key。
#!system=ios
#!arguments=API_KEY=&update_interval=10

[Panel]
SurgeMonitorAPI = title="Surge Monitor",content="正在获取数据...",style=info,script-name=surge_monitor_api,update-interval=%update_interval%

[Script]
surge_monitor_api = type=generic,timeout=8,script-path=https://raw.githubusercontent.com/AWelook/surge-metrics-panel/main/surge-monitor-api.js,script-update-interval=3600,argument="%API_KEY%"
