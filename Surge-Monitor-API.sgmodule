#!name=Surge Monitor iOS
#!desc=显示本机 Surge 运行时间、内存与接口累计流量。通过脚本内置 HTTP API 调用读取，无需填写 Key。
#!system=ios

[Panel]
SurgeMonitorAPI = title="Surge Monitor",content="正在获取数据...",style=info,script-name=surge_monitor_api,update-interval=10

[Script]
surge_monitor_api = type=generic,timeout=8,script-path=https://raw.githubusercontent.com/AWelook/surge-metrics-panel/main/surge-monitor-api.js?v=2,script-update-interval=3600
