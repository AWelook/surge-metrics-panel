#!name=Surge Metrics Panel V2
#!desc=在策略组页面显示本机 Surge 的运行时间、内存和接口累计流量。通过 Surge 内置 HTTP API 桥接读取，无需填写 API Key。
#!system=ios
#!arguments=update_interval=60

[Panel]
SurgeMetricsPanelV2 = title="Surge Monitor",content="轻点刷新读取本机指标",style=info,script-name=surge_metrics_panel_v2,update-interval=%update_interval%

[Script]
surge_metrics_panel_v2 = type=generic,timeout=8,script-path=https://raw.githubusercontent.com/AWelook/surge-metrics-panel/main/surge-metrics-panel.js?v=2,script-update-interval=3600
