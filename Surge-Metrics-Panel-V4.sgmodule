#!name=Surge Metrics Panel V4
#!desc=显示本机 Surge 的运行时间、内存和接口累计流量。固定 60 秒刷新，无模块参数，无需 API Key。
#!system=ios

[Panel]
SurgeMetricsPanelV4 = title="Surge Monitor",content="轻点刷新读取本机指标",style=info,script-name=surge_metrics_panel_v4,update-interval=60

[Script]
surge_metrics_panel_v4 = type=generic,timeout=8,script-path=https://raw.githubusercontent.com/AWelook/surge-metrics-panel/main/surge-metrics-panel-v3.js,script-update-interval=3600
